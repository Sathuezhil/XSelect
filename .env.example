# Copy to .env and replace every value before deployment.
# Never commit the real .env file.

MONGODB_URI=mongodb://127.0.0.1:27017/xselect
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string
AUTH_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin account created by npm run seed. Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@xselect.ae
ADMIN_PASSWORD=

# Optional. Seed links use xselectdemo-21 until you set your own Amazon Associates tag.
# A demo tag does not earn commission.
AMAZON_ASSOCIATE_TAG=
